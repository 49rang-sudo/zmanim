# ---------------------------------------------------------------
#  לוח שנה — משתני סביבה
#  העתיקו לקובץ .env ומלאו ערכים אמיתיים. .env לא נכנס ל-git.
# ---------------------------------------------------------------

# --- מסד נתונים -------------------------------------------------
# בפיתוח מקומי מול docker-compose:
DATABASE_URL="postgresql://luach:luach_dev_password@localhost:5432/luach?schema=public"

# --- Auth.js ----------------------------------------------------
# ייצור סוד: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="החליפו-אותי-בסוד-אקראי-באורך-32-בתים"
AUTH_URL="http://localhost:3000"
# Auth.js v5 מאחורי Nginx צריך את זה כדי לזהות פרוטוקול נכון
AUTH_TRUST_HOST="true"

# כניסת אדמין היא Google בלבד (אין יותר סיסמה) — Client ID/Secret
# מ-Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). ה-Redirect URI לרישום שם:
#   <NEXT_PUBLIC_BASE_URL>/api/auth/callback/google
# אופציונליים ברמת ה-schema: בלעדיהם שאר האתר ממשיך לעבוד, רק כניסת
# האדמין נכשלת בהודעה ברורה.
GOOGLE_CLIENT_ID="מזהה-לקוח-מ-google-cloud-console"
GOOGLE_CLIENT_SECRET="סוד-לקוח-מ-google-cloud-console"

# --- אחסון קבצים תואם S3 (R2 / MinIO / S3) ----------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="luach-artwork"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# MinIO ו-R2 דורשים path-style. AWS S3 אמיתי — הגדירו false.
S3_FORCE_PATH_STYLE="true"

# --- סליקה (sumit) -----------------------------------------------
# הסוד שמולו נחתם ה-webhook הנכנס מספק הסליקה (אירועים משניים
# בלבד — לא מקור האמת לחיוב, ראו SUMIT_API_KEY)
PAYMENT_WEBHOOK_SECRET="סוד-משותף-עם-ספק-הסליקה"
PAYMENT_PROVIDER="sumit"

# פרטי החברה אצל sumit — נדרשים גם לטופס האשראי המוטמע וגם לחיוב מהשרת.
# אופציונליים ברמת ה-schema: בלעדיהם האתר ממשיך לעבוד, אבל כל ניסיון
# תשלום ייכשל בהודעה ברורה. יש למלא לפני שהאתר גובה כסף אמיתי.
SUMIT_COMPANY_ID="12345678"
# סוד שרת — לעולם לא נחשף לדפדפן
SUMIT_API_KEY="מפתח-API-סודי-מ-sumit"
# מפתח ציבורי — מיועד להיחשף בדפדפן דרך הטמעת ה-JS
SUMIT_API_PUBLIC_KEY="מפתח-ציבורי-מ-sumit"
# TODO(sumit): לאמת מול לוח הבקרה של sumit לפני production
SUMIT_API_BASE_URL="https://api.sumit.co.il"

# --- כללי -------------------------------------------------------
# כתובת בסיס ציבורית — נבנית ממנה חזרה מהסליקה
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# כמה דקות משבצת נשמרת ללקוח לפני שהיא משתחררת
SLOT_HOLD_MINUTES="45"
# תקרת גודל קובץ אמנות במגה-בייט
MAX_UPLOAD_MB="60"

# --- זריעה ראשונית של משתמש ניהול -------------------------------
# המייל הזה נזרע כ-OWNER הראשון — הוא היחיד שיכול להוסיף מיילי אדמין
# נוספים דרך לוח הניהול. אין יותר סיסמה (כניסה דרך Google בלבד).
SEED_ADMIN_EMAIL="admin@luach.local"
