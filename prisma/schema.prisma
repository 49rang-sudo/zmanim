// ---------------------------------------------------------------
//  לוח שנה — מערכת הזמנת משבצות פרסום
//  Prisma schema · PostgreSQL
// ---------------------------------------------------------------

// Prisma 7: הגנרטור החדש כותב ל-src/generated, ו-url כבר לא נמצא כאן —
// כתובת ה-DB עוברת דרך prisma.config.ts (ל-CLI) ודרך driver adapter (בזמן ריצה).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------
//  ניהול
// ---------------------------------------------------------------

enum AdminRole {
  OWNER
  ADMIN
}

/// כניסה דרך Google בלבד — אין סיסמה. מייל שלא מופיע כאן נדחה
/// ב-signIn callback (src/lib/auth.ts) גם אם יש לו חשבון Google תקין.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// אופציונלי בכוונה — מנהל/ת שנכנסים רק דרך Google לא צריכים סיסמה.
  /// כשמוגדר, מאפשר גם כניסה עם אימייל+סיסמה (src/lib/auth.ts).
  passwordHash String?
  role         AdminRole @default(ADMIN)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// ---------------------------------------------------------------
//  ערים — לכל עיר מהדורת דפוס משלה, ולכן מלאי משבצות נפרד
// ---------------------------------------------------------------

model City {
  id               String   @id @default(cuid())
  name             String   @unique
  region           String?
  slug             String   @unique
  /// ברירת מחדל בזמן יצירת מהדורה חדשה (Edition.capacity) — לא
  /// חוסמת כלום בעצמה יותר, המלאי החי נספר ברמת המהדורה.
  capacity         Int      @default(14)
  /// הצגה ידנית בבורר הערים
  visible          Boolean  @default(true)
  /// הסתרה אוטומטית ברגע שהמלאי נגמר
  autoHideWhenFull Boolean  @default(true)
  /// כמות לוחות שמחולקת בעיר — טקסט שיווקי בכרטיס העיר
  distribution     Int?
  note             String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders       Order[]
  reservations SlotReservation[]
  editions     Edition[]

  @@index([visible, sortOrder])
  @@map("cities")
}

// ---------------------------------------------------------------
//  מהדורות — ריצת דפוס חודשית אחת של עיר אחת. כל המלאי (משבצות
//  פנויות/תפוסות) נספר ונחסם ברמת המהדורה, לא ברמת העיר.
// ---------------------------------------------------------------

enum EditionStatus {
  OPEN
  CLOSED
}

model Edition {
  id     String @id @default(cuid())
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  /// תווית עברית מלאה לתצוגה — למשל "כסלו תשפ״ז". טקסט חופשי, מוזן ידנית באדמין.
  hebrewLabel    String
  gregorianMonth Int
  gregorianYear  Int

  /// קיבולת המהדורה הזו. ברירת מחדל בזמן היצירה: City.capacity, אך ניתנת לעריכה בנפרד לכל מהדורה.
  capacity Int
  /// מועד סגירת ההזמנות/העלאת קבצים למהדורה הזו
  closesAt DateTime
  status   EditionStatus @default(OPEN)

  /// טקסט שיווקי קצר: למה כדאי לפרסם דווקא במהדורה הזו. אופציונלי,
  /// מוצג ללקוח בזמן דפדוף בין החודשים באשף ההזמנה.
  marketingNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations SlotReservation[]

  @@unique([cityId, gregorianYear, gregorianMonth])
  @@index([cityId, status, gregorianYear, gregorianMonth])
  @@map("editions")
}

// ---------------------------------------------------------------
//  תמונות השראה — שטח המכירה החדש של הלוח.
//
//  במקום רשת ריבועים אחידה, האזור הנמכר הוא תמונת אורח-חיים אחת
//  או יותר (קיר מטבח, עגלת תינוק), וכל תמונה נושאת "חלונות"
//  (Hotspot) במיקומים מדויקים בתוכה. כל חלון קשור לקטגוריית עסק
//  שמתאימה להקשר של התמונה.
//
//  לכל *חודש* קונספט (סצנה) משלו — אלול "שיפוץ הבית", תשרי
//  "לימודים והתפתחות" וכן הלאה. החזרתיות היא לפי חודש, לא גלובלית:
//  מהדורת אלול של *כל* עיר חולקת את אותה סצנה, אבל אלול ותשרי הן
//  שתי סצנות שונות. ראו InspirationImage.gregorianMonth.
//
//  רק המכירה עצמה (איזה עסק קנה איזה חלון, באיזו מהדורה) היא לפי
//  מהדורה, בדיוק כמו AdSlot היום.
// ---------------------------------------------------------------

model InspirationImage {
  id String @id @default(cuid())

  /// שם פנימי לזיהוי — "קיר מטבח", "עגלת תינוק"
  label String

  /// החודש הלועזי (1–12) שהסצנה הזו שייכת לו. אותו חודש בכל הערים
  /// מקבל את אותה סצנה; חודש אחר הוא קונספט אחר לגמרי.
  ///
  /// null = סצנה *כללית*, גיבוי לכל חודש שאין לו עדיין אמנות ייעודית.
  /// זה מה שמאפשר למערכת לעבוד לפני שהמעצבת סיפקה 12 סצנות. כלל
  /// הבחירה (boardForMonth ב-src/lib/site.ts): קודם תמונות שהחודש
  /// שלהן תואם למהדורה; רק אם אין כאלה — הכלליות.
  gregorianMonth Int?

  /// כתובת יציבה בתבנית /api/media/<key> — בדיוק כמו content.brand.logoUrl.
  /// הקובץ עצמו יושב באחסון הפרטי תחת media/ (ראו src/lib/s3.ts
  /// ו-src/app/api/admin/media/route.ts). לא מנגנון אחסון חדש.
  imageUrl String

  /// יחס רוחב/גובה מקורי — משמש לשריון מקום לפני שהתמונה נטענת,
  /// כדי שהחלונות לא "יקפצו" ממקומם בזמן הטעינה.
  aspectRatio Float @default(1.5)

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotspots Hotspot[]

  @@index([active, sortOrder])
  /// שליפת הסצנות של חודש מסוים (וגם הכלליות, gregorianMonth = null)
  @@index([gregorianMonth, active, sortOrder])
  @@map("inspiration_images")
}

/// שתי רמות נוכחות בתוך אותה סצנה. שתיהן חלונות ממשיים ממוקמים על
/// התמונה — לא מתג מופשט — אבל הן נספרות, מתומחרות ומוצגות בנפרד.
///
/// ANCHOR (עוגן) — נוכחות מרכזית: קשור לאלמנט הראשי בסצנה, נפח
///   ויזואלי גדול יותר, מחיר גבוה יותר.
/// COMPLEMENTARY (משלים) — קשור לחפץ/מוצר בודד בתוך הסצנה, קטן
///   יותר, זול יותר, ומחירו נקבע פר-חלון (טווח, לא קבוע אחד).
///
/// הזמינות נספרת לכל דרגה בנפרד באותה מהדורה: אפשר שכל העוגנים
/// של חודש ייתפסו בזמן שהמשלימים באותו חודש עדיין פנויים, ולהפך.
/// ראו tiers ב-EditionAvailability (src/lib/availability.ts).
enum HotspotTier {
  ANCHOR
  COMPLEMENTARY
}

/// חלון בודד בתוך תמונת השראה. תופס את התפקיד ש-col/row/colSpan/
/// rowSpan ממלאים ב-AdSlot בפריסת הרשת הישנה — אבל *רק* את התפקיד
/// הוויזואלי. היחידה הנמכרת נשארת AdSlot (ראו AdSlot.hotspotId),
/// כדי שכל לוגיקת התפיסה והקיבולת ב-src/lib/availability.ts תמשיך
/// לעבוד כמו שהיא, בלי כפילות.
model Hotspot {
  id                 String           @id @default(cuid())
  inspirationImageId String
  inspirationImage   InspirationImage @relation(fields: [inspirationImageId], references: [id], onDelete: Cascade)

  /// קטגוריית העסק שהחלון שמור לה — טקסט חופשי, למשל "חנות תינוקות".
  /// כל עוד החלון פנוי הוא מוצג כ"מקום זה שמור לחנות תינוקות";
  /// אחרי מכירה מוחלף בשם העסק שקנה.
  category String

  /// רמת הנוכחות — עוגן או משלים. ברירת מחדל COMPLEMENTARY כי היא
  /// הזולה והנפוצה: חלון שנוצר בלי הכרעה מפורשת לעולם לא ייצא
  /// "עוגן" בטעות ויתומחר גבוה מדי.
  tier HotspotTier @default(COMPLEMENTARY)

  /// מיקום וגודל באחוזים (0–100) מרוחב/גובה התמונה. אחוזים ולא
  /// פיקסלים — כך החלון נשאר מוצמד לאותה נקודה בתמונה בכל רוחב מסך.
  x      Float
  y      Float
  width  Float
  height Float

  /// מחיר באגורות. שדה *אפיון* בלבד — מה שנגבה בפועל בקופה הוא תמיד
  /// AdSlot.priceAgorot של המשבצת המקושרת (ראו src/app/api/orders/route.ts),
  /// וגם מה שמוצג ללקוח בבורר מגיע משם. הערך כאן הוא ברירת המחדל
  /// שממנה נכתב מחיר המשבצת בעת יצירת החלון. מקור אמת אחד לכסף.
  priceAgorot Int

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// המשבצת הנמכרת שמוצגת בחלון הזה. יחס 1:1 — AdSlot.hotspotId ייחודי.
  slot AdSlot?

  @@index([inspirationImageId, sortOrder])
  @@index([active, sortOrder])
  /// ספירת מלאי לפי דרגה (עוגן/משלים) בתוך סצנה
  @@index([tier, active])
  @@map("hotspots")
}

// ---------------------------------------------------------------
//  משבצות — היחידה הנמכרת. זו עדיין הישות היחידה ש-Order ו-
//  SlotReservation מצביעים עליה, ולכן כל חישוב הקיבולת והתפיסה
//  בטוח-מרוצים נשאר ללא שינוי.
//
//  שתי פריסות ויזואליות אפשריות:
//   · ישנה — col/row/colSpan/rowSpan על רשת CSS (נשמר, הזמנות עבר
//     מצביעות עליו).
//   · חדשה — hotspotId: החלון על תמונת ההשראה שבו המשבצת מוצגת.
// ---------------------------------------------------------------

model AdSlot {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  description String?

  col     Int
  row     Int
  colSpan Int @default(1)
  rowSpan Int @default(1)

  /// הפריסה החדשה. null = משבצת רשת ישנה. ייחודי — חלון אחד מוכר
  /// משבצת אחת בדיוק. SetNull ולא Cascade: מחיקת חלון לעולם לא
  /// תמחוק משבצת שהזמנות קיימות מצביעות עליה.
  hotspotId String?  @unique
  hotspot   Hotspot? @relation(fields: [hotspotId], references: [id], onDelete: SetNull)

  widthCm  Float
  heightCm Float

  /// מחיר באגורות — כסף לעולם לא נשמר כ-Float
  priceAgorot Int
  badge       String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  reservations SlotReservation[]

  @@index([active, sortOrder])
  @@map("ad_slots")
}

// ---------------------------------------------------------------
//  הזמנות
// ---------------------------------------------------------------

enum OrderStatus {
  /// נוצרה, תנאים אושרו, עיר נבחרה — ממתינה לקובץ
  PENDING
  /// קובץ הועלה, המשתמש הופנה לסליקה
  AWAITING_PAYMENT
  /// תשלום אושר
  PAID
  /// בוטלה ידנית
  CANCELLED
  /// ההחזקה פגה לפני תשלום
  EXPIRED
}

/// מצב הטיפול הגרפי — נפרד לחלוטין ממצב התשלום.
/// הזמנה יכולה להיות משולמת אך עדיין לא מטופלת גרפית.
enum ProductionStatus {
  /// ממתינה לטיפול הגרפיקאית
  WAITING
  /// הקובץ הורד ונלקח לעיבוד
  HANDLED
}

model Order {
  id        String      @id @default(cuid())
  /// מזהה קריא לבני אדם — LU-7QK4X2
  reference String      @unique
  status    OrderStatus @default(PENDING)

  slotId String
  slot   AdSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  /// המחיר משוכפל לתוך ההזמנה — שינוי מחירון לא משנה הזמנות עבר.
  /// בחבילה, זה כבר הסכום הכולל אחרי הנחה (כל המהדורות, לא ליחידה).
  priceAgorot Int
  sku         String

  /// --- חבילת פרסום מרובת-מהדורות (אופציונלי) ---
  /// null = הזמנה חד-פעמית (מהדורה אחת). ראו src/lib/packages.ts —
  /// עכשיו רק תוויות פריסט לתצוגה, לא מקור האמת למה שנתפס בפועל.
  packageTier     String?
  /// שדה תצוגה מוכפל בכוונה — חייב להיות שווה selections.length.
  packageEditions Int     @default(1)
  /// כל הבחירות בפועל בהזמנה: לכל מהדורה — איזו משבצת נבחרה בה.
  /// יכולות להיות משבצות שונות (באותו סוג/גודל) בכל חודש — ראו
  /// SlotSelection ב-src/lib/availability.ts. קפוא בזמן היצירה, כדי
  /// שנתיב השחזור ב-confirmReservation ידע לתפוס מחדש במדויק גם
  /// אחרי ששורות SlotReservation המקוריות כבר נמחקו (החזקה שפגה).
  selections      Json

  contactName  String
  businessName String?
  phone        String
  email        String
  notes        String?

  /// ההטבה החודשית שהעסק מציע לקוני הלוח — למשל "בין כל הקונים
  /// עגלה החודש יוגרל כיסוי גשם לעגלה". נאסף באותו שלב כמו פרטי
  /// הקשר באשף. זה גם הטקסט שההגרלה (שלב 3) מתנהלת סביבו.
  monthlyBenefit String?

  tosAcceptedAt DateTime?
  tosVersion    String?

  fileKey        String?
  fileName       String?
  fileSize       Int?
  fileMime       String?
  fileUploadedAt DateTime?

  paymentProvider String?
  paymentRef      String?
  paidAt          DateTime?

  /// --- טיפול גרפי ---
  /// נקבע אוטומטית ל-HANDLED ברגע שהקובץ הורד מלוח הניהול
  productionStatus    ProductionStatus @default(WAITING)
  artworkDownloadedAt DateTime?
  artworkDownloadedBy String?
  productionNote      String?

  /// טוקן יכולת — מאפשר ללקוח להמשיך את ההזמנה שלו בלי התחברות
  accessToken String  @unique
  adminNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations       SlotReservation[]
  receiptSubmissions ReceiptSubmission[]
  raffleDraws        RaffleDraw[]

  @@index([status, createdAt])
  @@index([cityId, slotId])
  /// לוח הגרפיקאית מסנן בדיוק לפי הצירוף הזה
  @@index([cityId, productionStatus])
  @@map("orders")
}

// ---------------------------------------------------------------
//  תפיסת מקום במשבצת ספציפית במהדורה ספציפית.
//
//  ייחודיות אמיתית לפי (editionId, slotId): אותה משבצת לא יכולה
//  להיות תפוסה פעמיים באותה מהדורה. הקיבולת נספרת ברמת המהדורה
//  מול Edition.capacity, וההגנה מפני מרוץ היא נעילת שורת/שורות
//  ה-Edition הרלוונטיות (FOR UPDATE) בזמן התפיסה — האינדקס הייחודי
//  הוא הגנה כפולה לכל נתיב שבטעות לא עבר דרך הנעילה.
// ---------------------------------------------------------------

model SlotReservation {
  id        String @id @default(cuid())
  cityId    String
  slotId    String
  editionId String

  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  city    City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  slot    AdSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  /// null = תפוס לצמיתות (שולם). תאריך = החזקה זמנית שפגה בו
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([editionId, slotId])
  @@index([cityId])
  @@index([orderId])
  @@index([expiresAt])
  @@map("slot_reservations")
}

// ---------------------------------------------------------------
//  תוכן האתר — רשומה יחידה, גוף JSON מאומת ב-zod
// ---------------------------------------------------------------

model SiteContent {
  id             String   @id @default("singleton")
  landingEnabled Boolean  @default(true)
  tosVersion     String   @default("1.0")
  data           Json
  updatedAt      DateTime @updatedAt

  @@map("site_content")
}

// ---------------------------------------------------------------
//  אירועי סליקה — לוג גולמי + מניעת עיבוד כפול
// ---------------------------------------------------------------

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  orderRef   String?
  payload    Json
  processed  Boolean  @default(false)
  error      String?
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([orderRef])
  @@map("webhook_events")
}

// ---------------------------------------------------------------
//  רשימת תפוצה — הצטרפות וולונטרית בסימון וי בטופס ההזמנה.
//  עצמאית מ-Order בכוונה: נשארת גם אם ההזמנה עצמה פגה/בוטלה.
// ---------------------------------------------------------------

model MailingListSubscriber {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())

  @@map("mailing_list_subscribers")
}

// ---------------------------------------------------------------
//  פניות עסקים — "בדקו לי התאמה".
//
//  ליד, לא הזמנה. עסק שעדיין לא יודע איזה חודש מתאים לו משאיר כאן
//  פרטים, ואנחנו חוזרים אליו. במכוון *לא* מקושר ל-Order: הרוב
//  המכריע של הפניות לעולם לא יהפוך להזמנה, וקישור היה מכריח יצירת
//  הזמנה מדומה לכל פנייה.
//
//  שני מקורות, יעד אחד — טופס הפנייה המלא בתחתית עמוד הנחיתה
//  (סעיף 15 בקופי) והפופאפ הקצר של כוונת-יציאה (סעיף 16). הפופאפ
//  אוסף פחות שדות, ולכן כמעט הכול כאן אופציונלי; מה שחובה *לכל*
//  מקור נאכף בשכבת ה-API (src/app/api/inquiries/route.ts) ולא כאן,
//  כי הדרישה שונה בין שני הטפסים.
// ---------------------------------------------------------------

enum InquirySource {
  /// טופס הפנייה המלא בעמוד הנחיתה
  FORM
  /// הפופאפ הקצר (כוונת יציאה / דפדוף בלי שליחה)
  POPUP
}

enum InquiryStatus {
  /// התקבלה, עוד לא טופלה
  NEW
  /// יצרנו קשר, בבירור
  CONTACTED
  /// נמצאה התאמה והופנה לבחירת חודש
  MATCHED
  /// נסגרה (לא רלוונטי / לא נענה / הפך להזמנה)
  CLOSED
}

model BusinessInquiry {
  id String @id @default(cuid())

  /// שם העסק — חובה בטופס המלא, לא נאסף בפופאפ
  businessName String?
  /// תחום הפעילות. השדה היחיד שחובה בשני המקורות — בלעדיו אי אפשר
  /// לבדוק לאיזה קונספט העסק מתאים, וזו כל מטרת הפנייה.
  category String
  /// מיקום בארץ — חופשי, לא בהכרח עיר שיש לה מהדורה
  location String?

  contactName String?
  phone       String?
  email       String?

  /// "יש חודש או קונספט שכבר חשבתם עליו?" — טקסט חופשי בכוונה,
  /// ולא editionId: הפונה מקליד "בערך בחנוכה", לא בוחר מהדורה.
  monthGuess String?
  /// "משהו שחשוב שנדע?"
  note String?

  source InquirySource
  status InquiryStatus @default(NEW)

  /// הערת מנהלת — מה סוכם בשיחה
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// לוח הניהול מציג "חדשות קודם", ומסנן לפי סטטוס
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("business_inquiries")
}

// ---------------------------------------------------------------
//  קבלות והגרלות — שלבים 2 ו-3 של הפרויקט.
//
//  הטבלאות נוצרות כאן כבר עכשיו כדי שהסכמה תשתנה פעם אחת בלבד.
//  אף ממשק עדיין לא כותב אליהן: טופס העלאת הקבלות (שלב 2) וניהול
//  ההגרלות בלוח הניהול (שלב 3) ייבנו בהמשך.
// ---------------------------------------------------------------

enum ReceiptStatus {
  /// הועלתה, ממתינה לאישור המנהלת
  PENDING
  /// אושרה — משתתפת בהגרלה
  APPROVED
  /// נדחתה (לא קריאה, לא מהעסק הנכון, כפולה)
  REJECTED
}

/// קבלה שקונה העלה כדי להשתתף בהגרלה החודשית של עסק מסוים.
///
/// הקישור הוא ל-Order ולא לקטגוריה: הלקוחה אישרה מפורשות שקבלה
/// נספרת רק אם היא מהעסק המפרסם עצמו — התאמת קטגוריה לא מספיקה.
/// דרך ה-Order יש גם את המהדורה/העיר וגם את ההטבה (monthlyBenefit).
model ReceiptSubmission {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  submitterName String
  phone         String

  /// סכום הרכישה באגורות — מספר שלם, לעולם לא Float
  amountAgorot Int

  /// מפתח הקובץ באחסון הפרטי (ראו src/lib/s3.ts). לא כתובת ציבורית:
  /// קבלה היא מסמך פרטי, ההורדה עוברת דרך presigned URL לאחר אימות.
  fileKey String

  status      ReceiptStatus @default(PENDING)
  submittedAt DateTime      @default(now())

  /// ההגרלות שבהן הקבלה הזו יצאה זוכה
  wonDraws RaffleDraw[] @relation("RaffleWinner")

  @@index([orderId, status])
  @@index([status, submittedAt])
  @@map("receipt_submissions")
}

/// הגרלה שבוצעה על הקבלות של הזמנה אחת. שומרת גם את הסיכומים
/// (כמה משתתפים, כמה כסף) כדי שהדוח למפרסם יישאר נכון גם אם קבלות
/// נמחקו או שונו אחרי ההגרלה.
model RaffleDraw {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  drawnAt DateTime @default(now())

  /// null עד שההגרלה בוצעה בפועל / אם לא היו משתתפים כלל.
  /// SetNull ולא Cascade — מחיקת קבלה לא מוחקת את רשומת ההגרלה.
  winningSubmissionId String?
  winningSubmission   ReceiptSubmission? @relation("RaffleWinner", fields: [winningSubmissionId], references: [id], onDelete: SetNull)

  totalParticipants Int
  totalAmountAgorot Int

  @@index([orderId, drawnAt])
  @@map("raffle_draws")
}
